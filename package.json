{
  "name": "llm-diagram-generator",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "build:check": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "type-check:strict": "vue-tsc --noEmit --strict",
    "type-check:incremental": "vue-tsc --noEmit --incremental",
    "type-check:build": "vue-tsc --noEmit --tsBuildInfoFile .tsbuildinfo",
    "quality:check": "npm run type-check && npm run lint && npm run test",
    "quality:fix": "npm run lint && npm run format",
    "dev:ts": "concurrently \"npm run type-check:watch\" \"npm run dev\"",
    "dev:check": "tsx scripts/dev-check.ts",
    "setup:check": "npm run quality:check && npm run build:check",
    "sync:ts": "tsx scripts/sync-ts-config.ts",
    "final:check": "tsx scripts/final-check.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.6.2",
    "element-plus": "^2.4.4",
    "mermaid": "^10.6.1",
    "vue": "^3.3.8",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.15.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "concurrently": "^9.2.1",
    "cypress": "^13.6.0",
    "eslint": "^8.54.0",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "vue-tsc": "^3.1.5"
  }
}
