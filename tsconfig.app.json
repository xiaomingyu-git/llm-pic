{
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    // Super Development TypeScript Configuration - 极其宽松模式
    "strict": false, // 关闭严格模式
    "noUnusedLocals": false, // 不检查未使用的局部变量
    "noUnusedParameters": false, // 不检查未使用的参数
    "noImplicitReturns": false, // 不检查缺失的返回语句
    "exactOptionalPropertyTypes": false, // 不严格检查可选属性
    "noImplicitAny": false, // 允许隐式any类型
    "noImplicitThis": false, // 允许隐式this类型
    "noImplicitOverride": false, // 不要求显式覆盖声明
    "noPropertyAccessFromIndexSignature": false, // 完全允许索引签名访问
    "noUncheckedIndexedAccess": false, // 不严格检查索引访问
    "noFallthroughCasesInSwitch": false, // 不检查switch穿透
    "allowJs": true, // 允许JS文件
    "checkJs": false, // 不检查JS文件,
    "ignoreDeprecations": "5.0" // 忽略5.0版本的废弃警告
    // 确保编辑器正确识别类型
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": [
      "vite/client",
      "element-plus/global",
      "node"
    ]
  }
}
