          "API testing",
          "authenticated route",
          "JWT testing",
          "cookie auth",
          "test with auth",
          "测试路由",
          "测试接口",
          "测试API",
          "路由测试",
          "接口测试",
          "身份验证路由",
          "JWT测试",
          "Cookie认证",
          "认证测试"
        ],
        "intentPatterns": [
          "(test|debug|verify).*?(route|endpoint|API)",
          "(how to|how do I).*?test.*?(route|endpoint|API)",
          "test.*?(authenticated|auth|JWT|cookie)",
          "(测试|调试|验证).*?(路由|接口|API)",
          "(如何|怎么).*?测试.*?(路由|接口|API)",
          "测试.*?(认证|身份验证|JWT|cookie)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/routes/**/*.ts",
          "**/test-*.js",
          "**/test-*.ts"
        ],
        "contentPatterns": [
          "router\\.(get|post|put|delete|patch)",
          "app\\.(get|post|put|delete|patch)"
        ]
      }
    },
    "error-tracking": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Sentry error tracking and performance monitoring patterns",
      "mcpTools": [
        "mcp__acp__Read",
        "mcp__acp__Write",
        "mcp__acp__Edit",
        "mcp__acp__Bash",
        "Glob",
        "Grep",
        "TodoWrite",
        "mcp__context7__resolve-library-id",
        "mcp__context7__get-library-docs"
      ],
      "promptTriggers": {
        "keywords": [
          "error handling",
          "exception",
          "sentry",
          "error tracking",
          "captureException",
          "monitoring",
          "performance tracking",
          "错误处理",
          "异常",
          "错误跟踪",
          "监控",
          "性能跟踪"
        ],
        "intentPatterns": [
          "(add|create|implement|setup).*?(error handling|sentry|error tracking)",
          "(fix|handle|catch).*?(error|exception)",
          "(how to|best practice).*?(error|sentry|monitoring)",
          "(添加|创建|实现|设置).*?(错误处理|sentry|错误跟踪)",
          "(修复|处理|捕获).*?(错误|异常)",
          "(如何|最佳实践).*?(错误|sentry|监控)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "**/instrument.ts",
          "**/sentry*.ts",
          "**/*Controller.ts",
          "**/*Service.ts"
        ],
        "contentPatterns": [
          "@sentry",
          "Sentry\\.",
          "captureException",
          "captureMessage"
        ]
      }
    }
  },
  "notes": {
    "enforcement_types": {
      "suggest": "Skill suggestion appears but doesn't block execution",
      "block": "Requires skill to be used before proceeding (guardrail)",
      "warn": "Shows warning but allows proceeding"
    },
    "priority_levels": {
      "critical": "Highest - Always trigger when matched",
      "high": "Important - Trigger for most matches",
      "medium": "Moderate - Trigger for clear matches",
      "low": "Optional - Trigger only for explicit matches"
    },
    "customization": {
