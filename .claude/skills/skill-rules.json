        "mcp__acp__BashOutput",
        "mcp__acp__KillShell",
        "mcp__acp__Read",
        "TodoWrite",
        "Task"
      ],
      "promptTriggers": {
        "keywords": [
          "test route",
          "test endpoint",
          "test API",
