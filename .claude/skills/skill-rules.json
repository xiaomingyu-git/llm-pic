{
  "version": "1.0",
  "description": "Skill activation triggers for Claude Code. Controls when skills automatically suggest or block actions.",
  "mcpPermissions": {
    "enableAllProjectMcpServers": true,
    "allowedTools": [
      "Edit:*",
      "Write:*",
      "MultiEdit:*",
      "NotebookEdit:*",
      "Bash:*",
      "Task:*",
      "Glob:*",
      "Grep:*",
      "Read:*",
      "WebFetch:*",
      "WebSearch:*",
      "ExitPlanMode:*",
      "AskUserQuestion:*",
      "TodoWrite:*",
      "mcp__acp__Read:*",
      "mcp__acp__Write:*",
      "mcp__acp__Edit:*",
      "mcp__acp__Bash:*",
      "mcp__acp__BashOutput:*",
      "mcp__acp__KillShell:*",
      "mcp__context7__resolve-library-id:*",
      "mcp__context7__get-library-docs:*",
      "mcp__playwright__browser_*",
      "mcp__web-reader__webReader:*",
      "mcp__web-search-prime__webSearchPrime:*"
    ],
    "defaultMode": "acceptEdits"
  },
  "skills": {
    "skill-developer": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Meta-skill for creating and managing Claude Code skills",
      "mcpTools": [
        "mcp__acp__Read",
        "mcp__acp__Write",
        "mcp__acp__Edit",
        "mcp__acp__Bash",
        "TodoWrite",
        "Glob",
        "Grep"
      ],
      "promptTriggers": {
        "keywords": [
          "skill system",
          "create skill",
          "add skill",
          "skill triggers",
          "skill rules",
          "hook system",
          "skill development",
          "skill-rules.json",
          "技能系统",
          "创建技能",
          "添加技能",
          "技能触发",
          "技能规则",
          "钩子系统",
          "技能开发"
        ],
        "intentPatterns": [
          "(how do|how does|explain).*?skill",
          "(create|add|modify|build).*?skill",
          "skill.*?(work|trigger|activate|system)",
          "技能.*?(如何|怎么|解释|说明)",
          "(创建|添加|修改|构建).*?技能",
          "技能.*?(工作|触发|激活|系统)"
        ]
      }
    },
    "backend-dev-guidelines": {
      "type": "domain",
      "enforcement": "suggest",
      "priority": "high",
      "description": "Backend development patterns for Node.js/Express/TypeScript",
      "mcpTools": [
        "mcp__acp__Read",
        "mcp__acp__Write",
        "mcp__acp__Edit",
        "mcp__acp__Bash",
        "mcp__acp__BashOutput",
        "Glob",
        "Grep",
        "Task",
        "ExitPlanMode",
        "TodoWrite",
        "mcp__context7__resolve-library-id",
        "mcp__context7__get-library-docs"
      ],
      "promptTriggers": {
        "keywords": [
          "backend",
          "backend development",
          "microservice",
          "controller",
          "service",
          "repository",
          "route",
          "routing",
          "express",
          "API",
          "endpoint",
          "middleware",
          "validation",
          "Zod",
          "Prisma",
          "database access",
          "BaseController",
          "dependency injection",
          "unifiedConfig",
          "configuration",
          "后端",
          "后端开发",
          "微服务",
          "控制器",
          "服务",
          "仓库",
          "路由",
          "接口",
          "中间件",
          "验证",
          "数据库访问",
          "依赖注入",
          "配置"
        ],
        "intentPatterns": [
          "(create|add|implement|build).*?(route|endpoint|API|controller|service|repository)",
          "(fix|handle|debug).*?(error|exception|backend)",
          "(add|implement).*?(middleware|validation|error.*?handling)",
          "(organize|structure|refactor).*?(backend|service|API)",
          "(how to|best practice).*?(backend|route|controller|service)",
          "(创建|添加|实现|构建).*?(路由|接口|API|控制器|服务|仓库)",
          "(修复|处理|调试).*?(错误|异常|后端)",
          "(添加|实现).*?(中间件|验证|错误.*?处理)",
          "(组织|结构|重构).*?(后端|服务|API)",
          "(如何|最佳实践).*?(后端|路由|控制器|服务)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "blog-api/src/**/*.ts",
          "auth-service/src/**/*.ts",
          "notifications-service/src/**/*.ts",
          "backend/**/*.ts",
          "api/**/*.ts",
          "server/**/*.ts",
          "services/**/*.ts"
        ],
        "pathExclusions": [
          "**/*.test.ts",
          "**/*.spec.ts"
        ],
        "contentPatterns": [
          "router\\.",
          "app\\.(get|post|put|delete|patch)",
          "export.*Controller",
          "export.*Service",
          "prisma\\."
        ]
      }
    },
    "frontend-dev-guidelines": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "high",
      "description": "React/TypeScript best practices including MUI v7 compatibility",
      "mcpTools": [
        "mcp__acp__Read",
        "mcp__acp__Write",
        "mcp__acp__Edit",
        "mcp__acp__Bash",
        "Glob",
        "Grep",
        "Task",
        "TodoWrite",
        "mcp__context7__resolve-library-id",
        "mcp__context7__get-library-docs",
        "mcp__playwright__browser_*"
      ],
      "promptTriggers": {
        "keywords": [
          "component",
          "react component",
          "UI",
          "interface",
          "page",
          "modal",
          "dialog",
          "form",
          "MUI",
          "Material-UI",
          "Grid",
          "styling",
          "frontend",
          "React",
          "组件",
          "界面",
          "页面",
          "弹窗",
          "对话框",
          "表单",
          "前端",
          "样式",
          "布局"
        ],
        "intentPatterns": [
          "(create|add|make|build|update|modify|edit).*?(component|UI|page|modal|dialog|form)",
          "(how to|best practice).*?(component|react|MUI)",
          "(style|design|layout).*?(component|UI)",
          "(创建|添加|制作|构建|更新|修改|编辑).*?(组件|界面|页面|弹窗|对话框|表单)",
          "(如何|最佳实践).*?(组件|react|MUI)",
          "(样式|设计|布局).*?(组件|界面)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "frontend/src/**/*.tsx",
          "frontend/src/**/*.ts",
          "client/src/**/*.tsx",
          "client/src/**/*.ts",
          "src/**/*.tsx"
        ],
        "pathExclusions": [
          "**/*.test.tsx",
          "**/*.test.ts",
          "**/*.spec.tsx",
          "**/*.spec.ts",
          "**/*.styles.ts",
          "**/vite.config.ts",
          "**/tsconfig.json"
        ],
        "contentPatterns": [
          "from '@mui/material';",
          "import.*Grid.*from.*@mui",
          "<Grid ",
          "Grid2",
          "Unstable_Grid",
          "makeStyles",
          "@material-ui/core"
        ]
      },
      "blockMessage": "⚠️ BLOCKED - Frontend Best Practices Required\n\n📋 REQUIRED ACTION:\n1. Use Skill tool: 'frontend-dev-guidelines'\n2. Review MUI v7 patterns (Grid uses size={{}} prop, NOT xs/sm props)\n3. Check React/TypeScript best practices\n4. Use proper styling patterns\n5. Then retry this edit\n\nReason: Enforce MUI v7 compatibility and React best practices\nFile: {file_path}\n\n💡 TIP: Add '// @skip-validation' comment to skip future checks",
      "skipConditions": {
        "sessionSkillUsed": true,
        "fileMarkers": [
          "@skip-validation"
        ],
        "envOverride": "SKIP_FRONTEND_GUIDELINES"
      }
    },
    "vue-dev-guidelines": {
      "type": "guardrail",
      "enforcement": "block",
      "priority": "high",
      "description": "Vue 3 + TypeScript + Element Plus best practices",
      "mcpTools": [
        "mcp__acp__Read",
        "mcp__acp__Write",
        "mcp__acp__Edit",
        "mcp__acp__Bash",
        "Glob",
        "Grep",
        "Task",
        "TodoWrite",
        "mcp__context7__resolve-library-id",
        "mcp__context7__get-library-docs",
        "mcp__playwright__browser_*",
        "WebFetch",
        "WebSearch"
      ],
      "promptTriggers": {
        "keywords": [
          "vue component",
          "Vue 3",
          "composition api",
          "Element Plus",
          "UI component",
          "interface",
          "page",
          "modal",
          "dialog",
          "form",
          "frontend",
          "组件",
          "界面",
          "页面",
          "弹窗",
          "对话框",
          "表单",
          "前端",
          "样式",
          "布局",
          "ref",
          "reactive",
          "computed",
          "watch",
          "props",
          "emits",
          "slots"
        ],
        "intentPatterns": [
          "(create|add|make|build|update|modify|edit).*?(vue component|component|UI|page|modal|dialog|form)",
          "(how to|best practice).*?(vue component|vue|Element Plus)",
          "(style|design|layout).*?(vue component|UI)",
          "(创建|添加|制作|构建|更新|修改|编辑).*?(Vue组件|组件|界面|页面|弹窗|对话框|表单)",
          "(如何|最佳实践).*?(Vue组件|vue|Element Plus)",
          "(样式|设计|布局).*?(Vue组件|界面)"
        ]
      },
      "fileTriggers": {
        "pathPatterns": [
          "src/**/*.vue",
          "components/**/*.vue",
          "src/**/*.ts"
        ],
        "pathExclusions": [
          "**/*.test.ts",
          "**/*.test.vue",
          "**/*.spec.ts",
          "**/*.spec.vue",
          "**/vite.config.ts",
          "**/tsconfig.json"
        ],
        "contentPatterns": [
          "from 'vue';",
          "from 'element-plus';",
          "import.*from.*element-plus",
          "defineComponent",
          "ref\\(",
          "reactive\\(",
          "computed\\(",
          "watch\\(",
          "<script setup>",
          "<template>",
          "<script lang=\"ts\">"
        ]
      },
      "blockMessage": "⚠️ BLOCKED - Vue 3 Best Practices Required\n\n📋 REQUIRED ACTION:\n1. Use Skill tool: 'vue-dev-guidelines'\n2. Review Vue 3 Composition API patterns\n3. Check Element Plus best practices\n4. Use proper TypeScript definitions\n5. Follow Vue 3 component structure\n\nReason: Enforce Vue 3 + TypeScript + Element Plus best practices\nFile: {file_path}\n\n💡 TIP: Add '// @skip-vue-validation' comment to skip future checks",
      "skipConditions": {
        "sessionSkillUsed": true,
        "fileMarkers": [
          "@skip-vue-validation"
        ],
        "envOverride": "SKIP_VUE_GUIDELINES"
      }
    },
    "route-tester": {
      "type": "domain",
      "enforcement": "suggest",
