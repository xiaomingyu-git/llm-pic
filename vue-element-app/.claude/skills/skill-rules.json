          "Error resolution",
          "Task management"
        ],
        "error-tracking": [
          "File operations",
          "Local error logging",
          "Performance monitoring",
          "Browser debugging",
          "Code search",
          "Task management"
        ]
      },
      "automaticActivation": "Skills can now automatically call MCP tools when activated"
